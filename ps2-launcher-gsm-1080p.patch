diff --git a/ee_core/src/gsm_engine.S b/ee_core/src/gsm_engine.S
index 168d66f..b76df3f 100644
--- a/ee_core/src/gsm_engine.S
+++ b/ee_core/src/gsm_engine.S
@@ -168,6 +168,23 @@ Hook_SetGsCrt:
  * Otherwise, call the original SetGsCrt() syscall handler and let it configure the GS for us.
  */
 
+#ifdef GSM_1080P
+    li      $a3, GS_MODE_DTV_1080P
+    bne     $a1, $a3, Chk_DTV_576P
+    nop
+
+    # Mode 0x54 has no ROM SetGsCrt handler. Program its synthetic raster directly.
+    # Temporarily disarm the GS write breakpoint so timing-sensitive PLL writes are not
+    # rewritten by GSHandler; Skip_Call_Original_SetGsCrt re-arms it below.
+    jal     Disable_GSBreakpoint
+    nop
+    jal     DTV_1080P
+    nop
+    b       Skip_Call_Original_SetGsCrt
+    nop
+
+Chk_DTV_576P:
+#endif
     li      $a3, GS_MODE_DTV_576P
     la      $t0, GSMFlags
     bne     $a1, $a3, Call_SetGsCrt
diff --git a/ee_core/src/gsm_engine_adv.S b/ee_core/src/gsm_engine_adv.S
index 8b78937..4ad51df 100644
--- a/ee_core/src/gsm_engine_adv.S
+++ b/ee_core/src/gsm_engine_adv.S
@@ -127,6 +127,95 @@ DTV576P_end:
 
 # -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 
+#ifdef GSM_1080P
+.ent DTV_1080P
+DTV_1080P:
+    # $v0 = GS base address
+    lui     $v0, (GS_BASE >> 16)
+
+    # Reset the PCRTC and PLL for the synthetic progressive 1080p raster.
+    lui     $v1, 0x0003
+    ori     $v1, 0x4223
+    dsll    $v1, 16
+    ori     $v1, 0x04B1
+    sd      $v1, GS_SMODE1($v0)
+
+    # GS revisions >= 0x19 use revised horizontal sync timing.
+    ld      $v1, GS_CSR($v0)
+    dsrl    $v1, 16
+    andi    $v1, 0xFF
+    sltiu   $v1, 0x19
+    bnez    $v1, DTV_1080P_oldGS
+    nop
+
+    lui     $v1, 0x0003
+    ori     $v1, 0x4420
+    dsll    $v1, 16
+    ori     $v1, 0x0B04
+    dsll    $v1, 16
+    ori     $v1, 0x182D
+    sd      $v1, GS_SYNCH1($v0)
+    lui     $v1, 0x0020
+    ori     $v1, 0xFB61
+    sd      $v1, GS_SYNCH2($v0)
+    b       DTV_1080P_syncv
+    nop
+
+DTV_1080P_oldGS:
+    lui     $v1, 0x0003
+    ori     $v1, 0x4420
+    dsll    $v1, 16
+    ori     $v1, 0x0B04
+    dsll    $v1, 16
+    ori     $v1, 0x3829
+    sd      $v1, GS_SYNCH1($v0)
+    lui     $v1, 0x0020
+    ori     $v1, 0xEB63
+    sd      $v1, GS_SYNCH2($v0)
+
+DTV_1080P_syncv:
+    lui     $v1, 0x0150
+    ori     $v1, 0xE002
+    dsll    $v1, 16
+    ori     $v1, 0x01C0
+    dsll    $v1, 16
+    ori     $v1, 0x0005
+    sd      $v1, GS_SYNCV($v0)
+
+    # Progressive output with the established 1080p GSM refresh value.
+    sd      $zero, GS_SMODE2($v0)
+    li      $v1, 4
+    sd      $v1, GS_SRFSH($v0)
+
+    # Keep reset asserted while the PLL settles, then release it with sync enabled.
+    lui     $v1, 0x0003
+    ori     $v1, 0x4223
+    dsll    $v1, 16
+    ori     $v1, 0x04B1
+    sd      $v1, GS_SMODE1($v0)
+    li      $v1, 0x7A120
+DTV_1080P_delay:
+    vnop
+    vnop
+    addiu   $v1, $v1, -1
+    vnop
+    vnop
+    bnez    $v1, DTV_1080P_delay
+    nop
+
+    lui     $v1, 0x0003
+    ori     $v1, 0x4220
+    dsll    $v1, 16
+    ori     $v1, 0x04B1
+    sd      $v1, GS_SMODE1($v0)
+
+    jr      $ra
+    nop
+.end DTV_1080P
+#endif
+
+# -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+
 # ----------------------------
 # SMODE1
 # .--------.-------.---------------.----------------------------------.-------.
