 void guiDrawBGPlasma()
 {
     if (gPS5Mode) {
-        rmDrawRectPrecise(0, 0, screenWidth, screenHeight, GS_SETREG_RGBA(0, 0, 0, 0x80));
+        // PS3 XMB-inspired blue gradient and slowly moving wave ribbons.
+        // Draw a small set of horizontal bands to keep the background cheap on the EE.
+        int y;
+        for (y = 0; y < 480; y += 20) {
+            int t = y * 255 / 480;
+            int r = 12 - (t * 8 / 255);
+            int g = 42 - (t * 24 / 255);
+            int b = 102 - (t * 58 / 255);
+            rmDrawRect(0, y, 640, 20, GS_SETREG_RGBA(r, g, b, 0x80));
+        }
+
+        int band;
+        for (band = 0; band < 7; ++band) {
+            int x = 0;
+            int idx = (int)(ps3WavePhase + band * 9) & 0xFF;
+            int idx2 = (int)((ps3WavePhase >> 1) + band * 5) & 0xFF;
+            int prevY = 222 + (ps3WaveSine[idx] * 48 / 1000) + (ps3WaveSine[idx2] * 24 / 1000) + (band - 3) * 13;
+            int distance = band - 3;
+            int alpha = 0x3A - (distance < 0 ? -distance : distance) * 7;
+            u64 color = GS_SETREG_RGBA(0x28 + band * 3, 0x88 + band * 4, 0xE8, alpha);
+
+            for (x = 20; x <= 640; x += 20) {
+                int waveX = x * 2 * 256 / 640;
+                int waveX2 = x * 256 / 640;
+                int waveY = 222 +
+                            (ps3WaveSine[(waveX + ps3WavePhase + band * 9) & 0xFF] * 48 / 1000) +
+                            (ps3WaveSine[(waveX2 + (ps3WavePhase >> 1) + band * 5) & 0xFF] * 24 / 1000) +
+                            (band - 3) * 13;
+                rmDrawLine(x - 20, prevY, x, waveY, color);
+                prevY = waveY;
+            }
+        }
+
+        ps3WavePhase++;
         return;
     }
 
